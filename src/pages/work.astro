---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = (await getCollection('work')).sort(
	(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

const carouselImages = [
	'/assets/06.jpg',
	'/assets/09.jpg',
	'/assets/18.jpg',
];
---

<BaseLayout title="Projects | Adriana Donca" description="Projects by Adriana Donca">
	<div class="projects-layout">
		<div class="carousel-section">
			<div class="carousel">
				{carouselImages.map((src, i) => (
					<img
						src={src}
						alt={`Project image ${i + 1}`}
						class:list={['carousel-img', i === 0 ? 'active' : '']}
						data-index={i}
					/>
				))}
				<button class="carousel-btn prev" id="prev" aria-label="Previous image">&#8592;</button>
				<button class="carousel-btn next" id="next" aria-label="Next image">&#8594;</button>
				<div class="carousel-dots">
					{carouselImages.map((_, i) => (
						<button class:list={['dot', i === 0 ? 'active' : '']} data-index={i} aria-label={`Go to image ${i + 1}`}></button>
					))}
				</div>
			</div>
		</div>

		<nav class="projects-nav">
			<ul>
				{projects.map((project, i) => (
					<li>
						<a href={`/work/${project.slug}/`} class="project-title">
							<span class="project-number">0{i + 1}</span>
							<span class="project-name">{project.data.title}</span>
						</a>
					</li>
				))}
			</ul>
		</nav>
	</div>
</BaseLayout>

<script>
	const imgs = document.querySelectorAll<HTMLImageElement>('.carousel-img');
	const dots = document.querySelectorAll<HTMLButtonElement>('.dot');
	let current = 0;
	let timer: ReturnType<typeof setInterval>;

	function goTo(idx: number) {
		imgs[current].classList.remove('active');
		dots[current].classList.remove('active');
		current = (idx + imgs.length) % imgs.length;
		imgs[current].classList.add('active');
		dots[current].classList.add('active');
	}

	function resetTimer() {
		clearInterval(timer);
		timer = setInterval(() => goTo(current + 1), 4000);
	}

	document.getElementById('prev')!.addEventListener('click', () => { goTo(current - 1); resetTimer(); });
	document.getElementById('next')!.addEventListener('click', () => { goTo(current + 1); resetTimer(); });
	dots.forEach(dot => {
		dot.addEventListener('click', () => { goTo(Number(dot.dataset.index)); resetTimer(); });
	});

	timer = setInterval(() => goTo(current + 1), 4000);
</script>

<style>
	.projects-layout {
		display: grid;
		grid-template-columns: 1fr 280px;
		height: calc(100vh - 160px);
		max-height: 800px;
		margin: 0 2rem 2rem;
		gap: 0;
		border: 1px solid var(--gray-800);
		border-radius: 0.75rem;
		overflow: hidden;
	}

	.carousel-section {
		position: relative;
		overflow: hidden;
	}

	.carousel {
		position: relative;
		width: 100%;
		height: 100%;
	}

	.carousel-img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0;
		transition: opacity 0.7s ease;
	}

	.carousel-img.active {
		opacity: 1;
	}

	.carousel-btn {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		background: rgba(0, 0, 0, 0.45);
		color: white;
		border: none;
		padding: 0.8rem 1.1rem;
		cursor: pointer;
		font-size: 1.2rem;
		z-index: 10;
		transition: background 0.2s;
		border-radius: 4px;
	}

	.carousel-btn:hover {
		background: rgba(0, 0, 0, 0.75);
	}

	.prev { left: 1rem; }
	.next { right: 1rem; }

	.carousel-dots {
		position: absolute;
		bottom: 1.25rem;
		left: 50%;
		transform: translateX(-50%);
		display: flex;
		gap: 0.5rem;
		z-index: 10;
	}

	.dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		border: none;
		background: rgba(255, 255, 255, 0.45);
		cursor: pointer;
		padding: 0;
		transition: background 0.2s;
	}

	.dot.active {
		background: white;
	}

	.projects-nav {
		padding: 2.5rem 2rem;
		border-left: 1px solid var(--gray-800);
		display: flex;
		align-items: center;
		background: var(--gray-999);
	}

	.projects-nav ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
		width: 100%;
	}

	.project-title {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		text-decoration: none;
		color: var(--gray-0);
		transition: color 0.2s;
	}

	.project-title:hover {
		color: var(--accent-regular);
	}

	.project-number {
		font-size: 0.65rem;
		color: var(--gray-400);
		letter-spacing: 0.15em;
		font-family: var(--font-brand);
	}

	.project-name {
		font-size: 0.85rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		font-family: var(--font-brand);
		font-weight: 500;
		line-height: 1.3;
	}

	@media (max-width: 50em) {
		.projects-layout {
			grid-template-columns: 1fr;
			grid-template-rows: 55vw auto;
			height: auto;
			max-height: none;
			margin: 0 1rem 2rem;
		}

		.projects-nav {
			border-left: none;
			border-top: 1px solid var(--gray-800);
			padding: 1.5rem 1rem;
		}

		.projects-nav ul {
			flex-direction: row;
			flex-wrap: wrap;
			gap: 1.25rem;
		}
	}
</style>
