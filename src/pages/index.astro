	.form-success {
		display: none;
		font-family: 'Montserrat', sans-serif;
		font-size: 0.65rem;
		font-weight: 300;
		letter-spacing: 0.1em;
		color: #000;
		text-transform: uppercase;
	}

	/* ── Projects list ── */
	.projects-list {
		position: fixed;
		inset: 0;
		background: #fff;
		display: none;
		flex-direction: column;
		z-index: 15;
		overflow-y: auto;
		scrollbar-width: none;
	}
	.projects-list::-webkit-scrollbar { display: none; }
	.projects-list.visible { display: flex; }

	.projects-list .site-header { padding-top: 3rem; }
	.projects-list .site-name { color: #000; }
	.projects-list .site-divider { border-top-color: rgba(0,0,0,0.3); }
	.projects-list .site-nav { border-bottom-color: rgba(0,0,0,0.3); }
	.projects-list .site-nav a { color: rgba(0,0,0,0.6); }
	.projects-list .site-nav a:hover { color: #000; }

	#back-btn-projects { color: #000; -webkit-text-stroke: 0.5px #000; }

	/* ── Credits bar ── */
	.credits-bar {
		grid-column: 1 / -1;
		overflow: hidden;
		white-space: nowrap;
		height: 2rem;
		line-height: 2rem;
		border-bottom: 1px solid rgba(0, 0, 0, 0.15);
		margin-bottom: 0.5rem;
	}
	.credits-track {
		display: inline-block;
		animation: scroll-credits 300s linear infinite;
		font-family: 'Montserrat', sans-serif;
		font-size: 0.85rem;
		font-weight: 400;
		letter-spacing: 0.12em;
		color: #000;
		text-transform: uppercase;
		line-height: 2rem;
	}
	@keyframes scroll-credits {
		0%   { transform: translateX(0); }
		100% { transform: translateX(-50%); }
