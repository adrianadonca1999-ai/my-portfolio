		color: rgba(0, 0, 0, 0.35);
	}

	.hp-proj-year {
		font-family: 'Montserrat', sans-serif;
		font-size: 0.62rem;
		font-weight: 300;
		letter-spacing: 0.1em;
		color: rgba(0, 0, 0, 0.35);
		flex-shrink: 0;
	}

	.site-header {
		text-align: center;
		padding: 3rem 6vw 0;
	}

	.site-name {
