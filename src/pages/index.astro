	.work-role {
		font-family: 'Montserrat', sans-serif;
		font-size: 0.72rem;
		font-weight: 600;
		color: #000;
		margin-bottom: 0.15rem;
	}
	.work-detail {
		font-family: 'Montserrat', sans-serif;
		font-size: 0.65rem;
		font-weight: 300;
		color: rgba(0, 0, 0, 0.6);
