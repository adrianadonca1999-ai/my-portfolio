		<div id="custom-cursor"></div>
		<!-- Back arrow for about panel -->
		<button class="back-btn" id="back-btn">&#8592;</button>

		<!-- About panel -->
		<div class="about-panel" id="about-panel">
			<div class="about-text">
				<h2>About</h2>
				<p>Adriana Donca is a production designer and producer whose work bridges architecture and cinematic storytelling. Based in Los Angeles, she studied Architecture at Aristotle University of Thessaloniki and holds a Master of Science in Fiction and Entertainment from SCI-Arc (Southern California Institute of Architecture).</p>
			</div>
			<div class="about-cv">
				<img src="/assets/cv.png" alt="Adriana Donca CV" />
			</div>
		</div>

		<!-- Back arrow for contact panel -->
		<button class="back-btn-contact" id="back-btn-contact">&#8592;</button>

		<!-- Contact panel (black square, centered) -->
		<div class="contact-panel" id="contact-panel">
			<h2>Contact</h2>
			<form id="contact-form" action="https://formspree.io/f/mrevzlzv" method="POST">
				<input type="text" name="name" placeholder="Name" required />
				<input type="email" name="email" placeholder="Email" required />
				<textarea name="message" placeholder="Message" required></textarea>
				<p class="form-success" id="form-success">Message sent!</p>
				<button type="submit">Send</button>
			</form>
			<span class="panel-expand">⤢</span>
		</div>

