	.edu-school {
		font-family: 'Montserrat', sans-serif;
		font-size: 0.7rem;
		font-weight: 300;
		color: rgba(0, 0, 0, 0.75);
		margin-bottom: 0.1rem;
	}
	.edu-detail {
		font-family: 'Montserrat', sans-serif;
		font-size: 0.65rem;
		font-weight: 300;
		color: rgba(0, 0, 0, 0.5);
	}

	/* ── Sketchbook panel ── */
	.sketchbook-panel {
		position: fixed;
		inset: 0;
		background: #fff;
		z-index: 20;
		display: none;
		flex-direction: column;
		padding: 5rem 6vw 4rem;
		overflow-y: auto;
		scrollbar-width: none;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.4s ease;
	}
	.sketchbook-panel::-webkit-scrollbar { display: none; }
	.sketchbook-panel.visible { display: flex; opacity: 1; pointer-events: auto; }

	.sketchbook-panel h2 {
		font-family: 'Montserrat', sans-serif;
		font-size: 2.4rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: #000;
		margin-bottom: 2rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid rgba(0, 0, 0, 0.15);
	}

	.sketchbook-section {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin-bottom: 3rem;
	}

	.sketchbook-section-title {
		font-family: 'Montserrat', sans-serif;
		font-size: 0.7rem;
		font-weight: 400;
		letter-spacing: 0.25em;
		text-transform: uppercase;
		color: rgba(0, 0, 0, 0.4);
		padding-bottom: 0.4rem;
		border-bottom: 1px solid rgba(0, 0, 0, 0.1);
