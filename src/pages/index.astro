		overflow: hidden;
	}

	.hp-carousel-img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0;
		transition: opacity 0.7s ease;
	}
	.hp-carousel-img.active { opacity: 1; }

	.hp-car-btn {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		background: rgba(0, 0, 0, 0.3);
		color: #fff;
		border: none;
		padding: 0.75rem 1rem;
		font-size: 1.1rem;
		font-family: 'Montserrat', sans-serif;
