		<div class="quad quad-br" id="quad-br"></div>

		<a class="name" id="name">Adriana Donca</a>

		<nav class="menu" id="menu">
			<a href="#" id="about-btn">About</a>
			<a href="#" id="projects-btn">Projects</a>
			<a href="#" id="contact-btn">Contact</a>
		</nav>

		<p class="clock" id="clock"></p>

		<script>
			const cursor = document.getElementById('custom-cursor');
			document.addEventListener('mousemove', function (e) {
				cursor.style.left = e.clientX + 'px';
				cursor.style.top = e.clientY + 'px';
			});

			function updateClock() {
				const now = new Date();
				const h = String(now.getHours()).padStart(2, '0');
				const m = String(now.getMinutes()).padStart(2, '0');
				const s = String(now.getSeconds()).padStart(2, '0');
				document.getElementById('clock').textContent = `${h}:${m}:${s}`;
			}
			updateClock();
			setInterval(updateClock, 1000);

			document.getElementById('name').addEventListener('click', function (e) {
				e.preventDefault();
				this.style.display = 'none';
				document.getElementById('menu').classList.add('visible');
				document.getElementById('quad-tl').classList.add('visible');
				document.getElementById('quad-tr').classList.add('visible');
				document.getElementById('quad-bl').classList.add('visible');
				document.getElementById('quad-br').classList.add('visible');
			});

			document.getElementById('back-btn').addEventListener('click', function () {
				document.getElementById('about-panel').classList.remove('visible');
				document.getElementById('back-btn').classList.remove('visible');
				document.getElementById('menu').classList.add('visible');
			});

			document.getElementById('about-btn').addEventListener('click', function (e) {
				e.preventDefault();
				document.getElementById('menu').classList.remove('visible');
				document.getElementById('about-panel').classList.add('visible');
				document.getElementById('back-btn').classList.add('visible');
			});

			document.getElementById('contact-form').addEventListener('submit', async function (e) {
				e.preventDefault();
				const form = e.target;
				const res = await fetch(form.action, {
					method: 'POST',
					body: new FormData(form),
					headers: { 'Accept': 'application/json' }
				});
				if (res.ok) {
					form.reset();
					document.getElementById('form-success').style.display = 'block';
				}
			});

			document.getElementById('contact-btn').addEventListener('click', function (e) {
				e.preventDefault();
				document.getElementById('menu').classList.remove('visible');
				document.getElementById('contact-panel').classList.add('visible');
				document.getElementById('back-btn-contact').classList.add('visible');
			});

			document.getElementById('back-btn-contact').addEventListener('click', function () {
				const panel = document.getElementById('contact-panel');
				panel.classList.remove('visible', 'expanded');
				document.querySelector('#contact-panel .panel-expand').textContent = '⤢';
				document.getElementById('back-btn-contact').classList.remove('visible');
				document.getElementById('menu').classList.add('visible');
			});

			document.querySelector('#contact-panel .panel-expand').addEventListener('click', function () {
				const panel = document.getElementById('contact-panel');
				panel.classList.toggle('expanded');
				this.textContent = panel.classList.contains('expanded') ? '⤡' : '⤢';
			});

			// Projects list
			document.getElementById('projects-btn').addEventListener('click', function (e) {
				e.preventDefault();
				document.getElementById('menu').classList.remove('visible');
				document.getElementById('projects-list').classList.add('visible');
				document.getElementById('back-btn-projects').classList.add('visible');
			});

			document.getElementById('back-btn-projects').addEventListener('click', function () {
				document.getElementById('projects-list').classList.remove('visible');
				document.getElementById('back-btn-projects').classList.remove('visible');
				document.getElementById('menu').classList.add('visible');
			});

			// Trespass grid
			document.getElementById('trespass-btn').addEventListener('click', function () {
				document.getElementById('projects-list').classList.remove('visible');
				document.getElementById('back-btn-projects').classList.remove('visible');
				document.getElementById('trespass-grid').classList.add('visible');
				document.getElementById('back-btn-grid').classList.add('visible');
			});

			document.getElementById('back-btn-grid').addEventListener('click', function () {
				document.getElementById('trespass-grid').classList.remove('visible');
				document.getElementById('back-btn-grid').classList.remove('visible');
				document.getElementById('projects-list').classList.add('visible');
				document.getElementById('back-btn-projects').classList.add('visible');
			});

			// Dance of the Seven Veils grid
			document.getElementById('dance-btn').addEventListener('click', function () {
				document.getElementById('projects-list').classList.remove('visible');
				document.getElementById('back-btn-projects').classList.remove('visible');
				document.getElementById('dance-grid').classList.add('visible');
				document.getElementById('back-btn-dance').classList.add('visible');
			});

			document.getElementById('back-btn-dance').addEventListener('click', function () {
				document.getElementById('dance-grid').classList.remove('visible');
				document.getElementById('back-btn-dance').classList.remove('visible');
				document.getElementById('projects-list').classList.add('visible');
				document.getElementById('back-btn-projects').classList.add('visible');
			});

			// Project descriptions
			const trespassDesc = 'A grieving woman living in a decaying apartment building becomes obsessed with her neighbor. As she secretly watches the life unfolding through the cracks in the wall, her longing for connection spirals into a dangerous fixation with horrifying consequences.\n\nShort Film — Coming Soon, 2026';
			const projects = {
				'STILL01.jpg': { title: 'Trespass', desc: trespassDesc },
				'STILL02.jpg': { title: 'Trespass', desc: trespassDesc },
				'STILL03.jpg': { title: 'Trespass', desc: trespassDesc },
				'STILL04.jpg': { title: 'Trespass', desc: trespassDesc },
				'STILL05.jpg': { title: 'Trespass', desc: trespassDesc },
				'STILL06.jpg': { title: 'Trespass', desc: trespassDesc },
				'STILL07.jpg': { title: 'Trespass', desc: trespassDesc },
			};

			const detail = document.getElementById('project-detail');
			const detailImg = document.getElementById('detail-img');
			const detailTitle = document.getElementById('detail-title');
			const detailDesc = document.getElementById('detail-desc');

			// Lightbox
			const lightbox = document.getElementById('lightbox');
			const lightboxImg = document.getElementById('lightbox-img');
			const lightboxCredits = document.getElementById('lightbox-credits-text');

			document.querySelectorAll('img.photo').forEach(function (img) {
				img.addEventListener('click', function () {
					lightboxImg.src = this.src;
					lightboxCredits.textContent = this.dataset.credits || '';
					lightbox.classList.add('open');
				});
			});

			lightbox.addEventListener('click', function () {
				lightbox.classList.remove('open');
				lightboxImg.src = '';
			});
		</script>
	</body>
</html>

<style>
	@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600;700&display=swap');

	*, *::before, *::after {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	html, body {
		width: 100%;
		height: 100%;
		background: #000;
		overflow: hidden;
		cursor: none;
	}

	#custom-cursor {
		position: fixed;
		width: 12px;
		height: 12px;
		background: #fff;
		pointer-events: none;
		z-index: 9999;
		transform: translate(-50%, -50%);
		mix-blend-mode: difference;
	}

	/* ── Back buttons ── */
	.back-btn, .back-btn-contact, .back-btn-projects, .back-btn-grid {
		position: fixed;
		font-family: 'Montserrat', sans-serif;
		font-size: 1.2rem;
		font-weight: 700;
		color: #fff;
		background: none;
		border: none;
		-webkit-text-stroke: 0.5px #fff;
		cursor: pointer;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.4s ease;
		z-index: 25;
		line-height: 1;
	}
	.back-btn          { top: 1.5rem; left: 1.5rem; }
	.back-btn-contact  { top: calc(50% - 5.25vw - 1.8rem); left: calc(50% - 5.25vw); }
	.back-btn-projects { top: 1.5rem; left: 1.5rem; }
	.back-btn-grid, .back-btn-dance { top: 1.5rem; left: 1.5rem; color: #fff; -webkit-text-stroke: 0.5px #fff; }

	.back-btn.visible,
	.back-btn-contact.visible,
	.back-btn-projects.visible,
	.back-btn-grid.visible,
	.back-btn-dance.visible { opacity: 1; pointer-events: auto; }

	.back-btn:hover,
	.back-btn-contact:hover,
	.back-btn-projects:hover,
	.back-btn-grid:hover { opacity: 0.5; }

	/* ── About panel ── */
	.about-panel {
		position: fixed;
		inset: 0;
		background: #000;
		z-index: 20;
		display: none;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		gap: 6vw;
		padding: 6vw;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.4s ease;
	}
	.about-panel.visible { display: flex; opacity: 1; pointer-events: auto; }

	.about-text {
		flex: 0 0 auto;
		max-width: 28vw;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.about-panel h2 {
		font-family: 'Montserrat', sans-serif;
		font-size: 2.4rem; font-weight: 700;
		letter-spacing: 0.1em; text-transform: uppercase; color: #fff;
	}
	.about-panel p {
		font-family: 'Montserrat', sans-serif;
		font-size: 0.85rem; font-weight: 300;
		letter-spacing: 0.03em;
		color: rgba(255,255,255,0.7);
		line-height: 1.9;
	}

	.about-cv {
		flex: 0 0 auto;
		max-height: 85vh;
		overflow-y: auto;
		scrollbar-width: none;
	}
	.about-cv::-webkit-scrollbar { display: none; }
	.about-cv img {
		display: block;
		max-height: 85vh;
		width: auto;
		max-width: 45vw;
		object-fit: contain;
	}

	/* ── Contact panel ── */
	.contact-panel {
		position: fixed;
		top: 50%; left: 50%;
		width: 10.5vw; height: 10.5vw;
		transform: translate(-50%, -50%) translateZ(0);
		-webkit-transform: translate(-50%, -50%) translateZ(0);
		background: #fff;
		z-index: 20;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		overflow: hidden;
		padding: 0.85rem;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.4s ease;
	}
	.contact-panel.visible { opacity: 1; pointer-events: auto; }
	.contact-panel { transition: opacity 0.4s ease, width 0.3s ease, height 0.3s ease; }
	.contact-panel.expanded {
		width: 16vw;
		height: 16vw;
		overflow-y: auto;
		clip-path: none;
		scrollbar-width: none;
	}
	.contact-panel.expanded::-webkit-scrollbar { display: none; }

	.contact-panel h2 {
		font-family: 'Montserrat', sans-serif;
		font-size: 1.8rem; font-weight: 700;
		letter-spacing: 0.1em; text-transform: uppercase; color: #000;
	}
	.contact-panel form {
		display: flex; flex-direction: column;
		gap: 0.5rem; flex: 1; margin-top: 0.8rem;
	}
	.contact-panel input, .contact-panel textarea {
		background: none; border: none;
		border-bottom: 1px solid rgba(0,0,0,0.3);
		color: #000;
		font-family: 'Montserrat', sans-serif;
		font-size: 0.6rem; font-weight: 300;
		letter-spacing: 0.1em; padding: 0.3rem 0;
		outline: none; width: 100%;
	}
	.contact-panel textarea { flex: 1; resize: none; }
	.contact-panel input::placeholder,
	.contact-panel textarea::placeholder {
		color: rgba(0,0,0,0.4); text-transform: uppercase;
	}
