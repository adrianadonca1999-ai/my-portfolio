	.contact-panel .site-name { color: #000; }
	.contact-panel .site-divider { border-top-color: rgba(0,0,0,0.3); }
	.contact-panel .site-nav { border-bottom-color: rgba(0,0,0,0.3); }
	.contact-panel .site-nav a { color: rgba(0,0,0,0.6); }
