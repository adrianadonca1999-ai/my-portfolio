<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Adriana Donca</title>
	</head>
	<body>
		<!-- Back arrow for about panel -->
		<button class="back-btn" id="back-btn">&#8592;</button>

		<!-- About panel (black square) -->
		<div class="about-panel" id="about-panel">
			<h2>Adriana Donca</h2>
			<p>Adriana Donca is a production designer and architect based between architecture, film, and visual storytelling. She studied Architecture in Greece and completed the Master of Science in Fiction and Entertainment at SCI-Arc, specializing in production design.</p>
			<p>Her work focuses on creating immersive visual worlds for film and narrative media. She has collaborated with directors on short films and worked as an art director, developing concepts, sets, and visual environments that support storytelling through space, atmosphere, and design.</p>
		</div>

		<!-- Back arrow for contact panel -->
		<button class="back-btn-contact" id="back-btn-contact">&#8592;</button>

		<!-- Contact panel (black square, centered) -->
		<div class="contact-panel" id="contact-panel">
			<h2>Contact</h2>
			<form id="contact-form" action="https://formspree.io/f/mrevzlzv" method="POST">
				<input type="text" name="name" placeholder="Name" required />
				<input type="email" name="email" placeholder="Email" required />
				<textarea name="message" placeholder="Message" required></textarea>
				<p class="form-success" id="form-success">Message sent!</p>
				<button type="submit">Send</button>
			</form>
		</div>

		<!-- White quadrant overlays -->
		<div class="quad quad-tl" id="quad-tl"></div>
		<div class="quad quad-tr" id="quad-tr"></div>
		<div class="quad quad-bl" id="quad-bl"></div>
		<div class="quad quad-br" id="quad-br"></div>

		<a class="name" id="name">Adriana Donca</a>

		<nav class="menu" id="menu">
			<a href="#" id="about-btn">About</a>
			<a href="/my-portfolio/work/">Projects</a>
			<a href="#" id="contact-btn">Contact</a>
		</nav>

		<p class="clock" id="clock"></p>

		<script>
			function updateClock() {
				const now = new Date();
				const h = String(now.getHours()).padStart(2, '0');
				const m = String(now.getMinutes()).padStart(2, '0');
				const s = String(now.getSeconds()).padStart(2, '0');
				document.getElementById('clock').textContent = `${h}:${m}:${s}`;
			}
			updateClock();
			setInterval(updateClock, 1000);

			document.getElementById('name').addEventListener('click', function (e) {
				e.preventDefault();
				this.style.display = 'none';
				document.getElementById('menu').classList.add('visible');
				document.getElementById('quad-tl').classList.add('visible');
				document.getElementById('quad-tr').classList.add('visible');
				document.getElementById('quad-bl').classList.add('visible');
				document.getElementById('quad-br').classList.add('visible');
			});

			document.getElementById('back-btn').addEventListener('click', function () {
				document.getElementById('about-panel').classList.remove('visible');
				document.getElementById('back-btn').classList.remove('visible');
				document.getElementById('menu').classList.add('visible');
			});

			document.getElementById('contact-form').addEventListener('submit', async function (e) {
				e.preventDefault();
				const form = e.target;
				const res = await fetch(form.action, {
					method: 'POST',
					body: new FormData(form),
					headers: { 'Accept': 'application/json' }
				});
				if (res.ok) {
					form.reset();
					document.getElementById('form-success').style.display = 'block';
				}
			});

			document.getElementById('contact-btn').addEventListener('click', function (e) {
				e.preventDefault();
				document.getElementById('menu').classList.remove('visible');
				document.getElementById('contact-panel').classList.add('visible');
				document.getElementById('back-btn-contact').classList.add('visible');
			});

			document.getElementById('back-btn-contact').addEventListener('click', function () {
				document.getElementById('contact-panel').classList.remove('visible');
				document.getElementById('back-btn-contact').classList.remove('visible');
				document.getElementById('menu').classList.add('visible');
			});

			document.getElementById('about-btn').addEventListener('click', function (e) {
				e.preventDefault();
				document.getElementById('menu').classList.remove('visible');
				document.getElementById('about-panel').classList.add('visible');
				document.getElementById('back-btn').classList.add('visible');
			});
		</script>
	</body>
</html>

<style>
	@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;700&display=swap');

	*, *::before, *::after {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	html, body {
		width: 100%;
		height: 100%;
		background: #fff;
		overflow: hidden;
	}

	.back-btn {
		position: fixed;
		top: calc(25% - 7vw - 1.8rem);
		left: calc(25% - 7vw);
		font-family: 'Montserrat', sans-serif;
		font-size: 1.2rem;
		font-weight: 700;
		color: #000;
		background: none;
		border: none;
		-webkit-text-stroke: 0.5px #000;
		cursor: pointer;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.4s ease;
		z-index: 25;
		line-height: 1;
	}

	.back-btn.visible {
		opacity: 1;
		pointer-events: auto;
	}

	.back-btn:hover {
		opacity: 0.5;
	}

	.about-panel {
		position: fixed;
		top: 25%;
		left: 25%;
		width: 14vw;
		height: 14vw;
		transform: translate(-50%, -50%);
		background: #000;
		z-index: 20;
		display: flex;
		flex-direction: column;
		justify-content: flex-start;
		padding: 1rem;
		gap: 0.6rem;
		overflow-y: auto;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.4s ease;
	}

	.about-panel.visible {
		opacity: 1;
		pointer-events: auto;
	}

	.about-panel h2 {
		font-family: 'Montserrat', sans-serif;
		font-size: 1.8rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: #fff;
	}

	.about-panel h3 {
		font-family: 'Montserrat', sans-serif;
		font-size: 0.65rem;
		font-weight: 300;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: #fff;
		margin-top: -0.3rem;
		margin-bottom: 0.6rem;
	}

	.about-panel p {
		font-family: 'Montserrat', sans-serif;
		font-size: 0.72rem;
		font-weight: 300;
		letter-spacing: 0.03em;
		color: rgba(255, 255, 255, 0.7);
		line-height: 1.7;
	}

	.back-btn-contact {
		position: fixed;
		top: calc(50% - 7.5vw - 1.8rem);
		left: calc(50% - 7.5vw);
		font-family: 'Montserrat', sans-serif;
		font-size: 1.2rem;
		font-weight: 700;
		color: #000;
		background: none;
		border: none;
		-webkit-text-stroke: 0.5px #000;
		cursor: pointer;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.4s ease;
		z-index: 25;
		line-height: 1;
	}

	.back-btn-contact.visible {
		opacity: 1;
		pointer-events: auto;
	}

	.back-btn-contact:hover { opacity: 0.5; }

	/* Contact panel — centered on page */
	.contact-panel {
		position: fixed;
		top: 50%;
		left: 50%;
		width: 15vw;
		height: 15vw;
		transform: translate(-50%, -50%);
		background: #000;
		z-index: 20;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding: 1.2rem;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.4s ease;
	}

	.contact-panel.visible {
		opacity: 1;
		pointer-events: auto;
	}

	.contact-panel h2 {
		font-family: 'Montserrat', sans-serif;
		font-size: 1.8rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: #fff;
	}

	.contact-panel form {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		flex: 1;
		margin-top: 0.8rem;
	}

	.contact-panel input,
	.contact-panel textarea {
		background: none;
		border: none;
		border-bottom: 1px solid rgba(255, 255, 255, 0.3);
		color: #fff;
		font-family: 'Montserrat', sans-serif;
		font-size: 0.6rem;
		font-weight: 300;
		letter-spacing: 0.1em;
		padding: 0.3rem 0;
		outline: none;
		width: 100%;
	}

	.contact-panel textarea {
		flex: 1;
		resize: none;
	}

	.contact-panel input::placeholder,
	.contact-panel textarea::placeholder {
		color: rgba(255, 255, 255, 0.4);
		text-transform: uppercase;
	}

	.contact-panel button {
		font-family: 'Montserrat', sans-serif;
		font-size: 0.6rem;
		font-weight: 700;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: #fff;
		background: none;
		border: 1px solid rgba(255, 255, 255, 0.4);
		padding: 0.4rem;
		cursor: pointer;
		transition: background 0.2s, color 0.2s;
	}

	.contact-panel button:hover {
		background: #fff;
		color: #000;
	}

	.form-success {
		display: none;
		font-family: 'Montserrat', sans-serif;
		font-size: 0.6rem;
		font-weight: 300;
		letter-spacing: 0.1em;
		color: #fff;
		text-transform: uppercase;
	}

	.quad {
		position: fixed;
		background: #fff;
		z-index: 1;
		opacity: 0;
		transition: opacity 0.4s ease;
		pointer-events: none;
	}

	.quad.visible {
		opacity: 1;
		pointer-events: auto;
	}

	.quad-tl { top: 0; left: 0; width: 50%; height: 50%; }
	.quad-tr { top: 0; left: 50%; width: 50%; height: 50%; }
	.quad-bl { top: 50%; left: 0; width: 50%; height: 50%; }
	.quad-br { top: 50%; left: 50%; width: 50%; height: 50%; }

	.name {
		position: fixed;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		font-family: 'Montserrat', sans-serif;
		font-size: 1.235rem;
		font-weight: 700;
		letter-spacing: 0.3em;
		text-transform: uppercase;
		color: #000;
		text-decoration: none;
		white-space: nowrap;
		z-index: 5;
		cursor: pointer;
	}

	.name:hover { opacity: 0.6; }

	.menu {
		display: none;
		flex-direction: column;
		align-items: flex-start;
		justify-content: space-between;
		position: fixed;
		top: 25%;
		left: 75%;
		transform: translate(-50%, -50%);
		width: 15.5vw;
		height: 15.5vw;
		background: #000;
		padding: 1.5rem;
		z-index: 5;
	}

	.menu.visible { display: flex; }

	.menu a {
		font-family: 'Montserrat', sans-serif;
		font-size: 1.8rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: #fff;
		text-decoration: none;
	}

	.menu a:hover { opacity: 0.6; }

	.clock {
		position: fixed;
		bottom: 1.5rem;
		right: 1.5rem;
		font-family: 'Montserrat', sans-serif;
		font-size: 0.8rem;
		font-weight: 300;
		letter-spacing: 0.15em;
		color: rgba(0, 0, 0, 0.5);
		z-index: 10;
	}
</style>
