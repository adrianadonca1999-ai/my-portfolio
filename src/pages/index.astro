	#back-btn-contact { color: #000; -webkit-text-stroke: 0.5px #000; }

	.contact-content {
		max-width: 560px;
		margin: 2.5rem auto 6rem;
		padding: 0 6vw;
		width: 100%;
	}

	.contact-info {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		margin-bottom: 2.5rem;
	}

	.contact-email {
		font-family: 'Montserrat', sans-serif;
		font-size: 0.85rem;
		font-weight: 400;
		letter-spacing: 0.04em;
		color: #000;
		text-decoration: none;
	}
	.contact-email:hover { opacity: 0.6; }

	.contact-social {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: #000;
	}

	.contact-ig {
		font-family: 'Montserrat', sans-serif;
		font-size: 0.8rem;
		font-weight: 300;
		letter-spacing: 0.04em;
		color: #000;
		text-decoration: none;
	}
	.contact-ig:hover { opacity: 0.6; }

	.contact-form-wrap { display: flex; flex-direction: column; gap: 1.2rem; }

	.contact-form-title {
		font-family: 'Montserrat', sans-serif;
		font-size: 1.05rem;
		font-weight: 400;
		letter-spacing: 0.02em;
		color: #000;
	}

	.contact-form-wrap form {
		display: flex;
		flex-direction: column;
		gap: 0.8rem;
	}
	.contact-form-wrap input,
	.contact-form-wrap textarea {
		background: none;
		border: none;
		border-bottom: 1px solid rgba(0, 0, 0, 0.25);
		color: #000;
		font-family: 'Montserrat', sans-serif;
		font-size: 0.72rem;
		font-weight: 300;
		letter-spacing: 0.06em;
		padding: 0.5rem 0;
		outline: none;
		width: 100%;
	}
	.contact-form-wrap textarea { resize: none; height: 7rem; }
	.contact-form-wrap input::placeholder,
	.contact-form-wrap textarea::placeholder { color: rgba(0, 0, 0, 0.35); text-transform: uppercase; font-size: 0.65rem; }
	.contact-form-wrap button {
		align-self: flex-start;
		font-family: 'Montserrat', sans-serif;
		font-size: 0.65rem;
		font-weight: 700;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: #000;
		background: none;
		border: 1px solid rgba(0, 0, 0, 0.4);
		padding: 0.5rem 1.5rem;
		cursor: pointer;
		transition: background 0.2s, color 0.2s;
