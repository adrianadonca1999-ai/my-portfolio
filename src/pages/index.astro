	.hp-proj-num {
		font-family: 'Montserrat', sans-serif;
		font-size: 0.6rem;
		font-weight: 400;
		letter-spacing: 0.1em;
		color: rgba(0, 0, 0, 0.35);
		flex-shrink: 0;
