	.full-credits-page {
		position: fixed;
		inset: 0;
		background: #fff;
		z-index: 18;
		display: none;
		flex-direction: column;
		padding: 5rem 6vw 4rem;
		overflow-y: auto;
		scrollbar-width: none;
