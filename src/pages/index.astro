	/* ── Contact panel ── */
	.contact-panel {
		position: fixed;
		inset: 0;
		background: #fff;
		z-index: 20;
		display: none;
		flex-direction: column;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.4s ease;
		overflow-y: auto;
		scrollbar-width: none;
