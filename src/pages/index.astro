		font-family: 'Montserrat', sans-serif;
		font-size: 3rem;
		font-weight: 700;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: #000;
		margin-bottom: 3rem;
		border-bottom: 1px solid rgba(0, 0, 0, 0.15);
		padding-bottom: 1.5rem;
