	}

	.hp-list-label {
		font-family: 'Montserrat', sans-serif;
		font-size: 0.6rem;
		font-weight: 700;
		letter-spacing: 0.25em;
		text-transform: uppercase;
		color: rgba(0, 0, 0, 0.35);
