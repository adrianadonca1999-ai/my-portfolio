	.back-btn.visible { opacity: 1; pointer-events: auto; }
	.back-btn:hover { opacity: 0.5; }

	/* ── Homepage split layout ── */
	.site-wrapper {
		width: 100%;
		height: 100vh;
		display: flex;
		flex-direction: row;
		overflow: hidden;
	}

	.hp-carousel {
