---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Adriana Donca</title>
	</head>
	<body>
		<div id="custom-cursor"></div>
		<!-- Back arrow for about panel -->
		<button class="back-btn" id="back-btn">&#8592;</button>

		<!-- About panel (black square) -->
		<div class="about-panel" id="about-panel">
			<h2>Adriana Donca</h2>
			<p>Adriana Donca is a production designer and architect based between architecture, film, and visual storytelling. She studied Architecture in Greece and completed the Master of Science in Fiction and Entertainment at SCI-Arc, specializing in production design.</p>
			<p>Her work focuses on creating immersive visual worlds for film and narrative media. She has collaborated with directors on short films and worked as an art director, developing concepts, sets, and visual environments that support storytelling through space, atmosphere, and design.</p>
		</div>

		<!-- Back arrow for contact panel -->
		<button class="back-btn-contact" id="back-btn-contact">&#8592;</button>

		<!-- Contact panel (black square, centered) -->
		<div class="contact-panel" id="contact-panel">
			<h2>Contact</h2>
			<form id="contact-form" action="https://formspree.io/f/mrevzlzv" method="POST">
				<input type="text" name="name" placeholder="Name" required />
				<input type="email" name="email" placeholder="Email" required />
				<textarea name="message" placeholder="Message" required></textarea>
				<p class="form-success" id="form-success">Message sent!</p>
				<button type="submit">Send</button>
			</form>
		</div>

		<!-- Projects list page -->
		<button class="back-btn-projects" id="back-btn-projects">&#8592;</button>
		<div class="projects-list" id="projects-list">
			<a href="#" class="project-title" id="trespass-btn">
				<span class="project-name">Trespass</span>
				<span class="project-subtitle">Laura Alvarez, 2026 (Coming Soon)</span>
				<p class="project-desc">A grieving woman living in a decaying apartment building becomes obsessed with her neighbor. As she secretly watches the life unfolding through the cracks in the wall, her longing for connection spirals into a dangerous fixation with horrifying consequences.</p>
			</a>
		</div>

		<!-- Trespass grid -->
		<button class="back-btn-grid" id="back-btn-grid">&#8592;</button>
		<div class="trespass-grid" id="trespass-grid">
			<div class="credits-bar">
				<div class="credits-track">
					LAURA ALVAREZ [DIRECTOR] / ALEX BORGER [ASSISTANT DIRECTOR] / LAURA ALVAREZ [PRODUCER] / ADRIANA DONCA [PRODUCER] / ISAAC CARPENTER [PRODUCTION ASSISTANT] / GEFFEN SHICHOR [DIRECTOR OF PHOTOGRAPHY] / JAVIER VIZARRETA [1ST AC] / KATERINA KAMYSHEVA [2ND AC] / SASHA ALAPUTINA [2ND AC] / NICO CAUTON [GAFFER] / JIRI BALCAR [STEADY CAM OPERATOR] / JIRI BALCAR [KEY GRIP] / ISAAC BARRESI [GRIP] / WILSON SANTOS ESTRADA [GRIP] / JONATHAN HORNBY [GRIP] / GIULIO GINESI [GRIP] / SHAE WELSH [BEST BOY ELECTRIC] / ADRIANA DONCA [PRODUCTION DESIGNER] / JACK LONDON FREEDMAN [ART DIRECTOR / HEAD CARPENTER] / ERON KUMAR [SET DRESSER] / LUIS GARCIA GRECH [SET DRESSER & AI DESIGN] / NATALIA GARCIA [STYLING] / DAVID DADON [PRODUCTION SOUND] / KASIEMBA OKEYO [PRODUCTION SOUND] / DIMITRIOS ASTRANTINIS [SOUND DESIGN & POST PRODUCTION] / ANNIKA HAUTMANN [SALOME] / STA SBRASKI [JOHANNA] / SPECIAL THANKS / EMIL TATEVOSIAN / LIAM YOUNG / ALEXEY MARFIN / ORIN TORATI / ADRIAN DONCA / MELINA DONCA / GABRIELA STEFANIA DONCA / ANA MARIA CADENA / ORLANDO RODRIGUEZ / OLGA LUCIA CADENA / LEONARDO ALVAREZ / SCI-ARC &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
					LAURA ALVAREZ [DIRECTOR] / ALEX BORGER [ASSISTANT DIRECTOR] / LAURA ALVAREZ [PRODUCER] / ADRIANA DONCA [PRODUCER] / ISAAC CARPENTER [PRODUCTION ASSISTANT] / GEFFEN SHICHOR [DIRECTOR OF PHOTOGRAPHY] / JAVIER VIZARRETA [1ST AC] / KATERINA KAMYSHEVA [2ND AC] / SASHA ALAPUTINA [2ND AC] / NICO CAUTON [GAFFER] / JIRI BALCAR [STEADY CAM OPERATOR] / JIRI BALCAR [KEY GRIP] / ISAAC BARRESI [GRIP] / WILSON SANTOS ESTRADA [GRIP] / JONATHAN HORNBY [GRIP] / GIULIO GINESI [GRIP] / SHAE WELSH [BEST BOY ELECTRIC] / ADRIANA DONCA [PRODUCTION DESIGNER] / JACK LONDON FREEDMAN [ART DIRECTOR / HEAD CARPENTER] / ERON KUMAR [SET DRESSER] / LUIS GARCIA GRECH [SET DRESSER & AI DESIGN] / NATALIA GARCIA [STYLING] / DAVID DADON [PRODUCTION SOUND] / KASIEMBA OKEYO [PRODUCTION SOUND] / DIMITRIOS ASTRANTINIS [SOUND DESIGN & POST PRODUCTION] / ANNIKA HAUTMANN [SALOME] / STA SBRASKI [JOHANNA] / SPECIAL THANKS / EMIL TATEVOSIAN / LIAM YOUNG / ALEXEY MARFIN / ORIN TORATI / ADRIAN DONCA / MELINA DONCA / GABRIELA STEFANIA DONCA / ANA MARIA CADENA / ORLANDO RODRIGUEZ / OLGA LUCIA CADENA / LEONARDO ALVAREZ / SCI-ARC &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
				</div>
			</div>
			<img class="photo" src="/assets/STILL01.jpg" />
			<img class="photo" src="/assets/STILL02.jpg" />
			<img class="photo" src="/assets/STILL03.jpg" />
			<img class="photo" src="/assets/STILL04.jpg" />
			<img class="photo" src="/assets/STILL05.jpg" />
			<img class="photo" src="/assets/STILL06.jpg" />
			<img class="photo" src="/assets/STILL07.jpg" />
			<div class="photo placeholder"></div>
			<div class="photo placeholder"></div>
			<div class="photo placeholder"></div>
			<div class="photo placeholder"></div>
			<div class="photo placeholder"></div>
			<div class="photo placeholder"></div>
			<div class="photo placeholder"></div>
			<div class="photo placeholder"></div>
			<div class="photo placeholder"></div>
		</div><!-- end trespass-grid -->

		<!-- Project detail page -->
		<div class="project-detail" id="project-detail">
			<button class="back-btn-detail" id="back-btn-detail">&#8592;</button>
			<div class="detail-image-wrap">
				<img class="detail-img" id="detail-img" src="" />
			</div>
			<div class="detail-info">
				<h2 id="detail-title"></h2>
				<p id="detail-desc"></p>
			</div>
		</div>

		<!-- White quadrant overlays -->
		<div class="quad quad-tl" id="quad-tl"></div>
		<div class="quad quad-tr" id="quad-tr"></div>
		<div class="quad quad-bl" id="quad-bl"></div>
		<div class="quad quad-br" id="quad-br"></div>

		<a class="name" id="name">Adriana Donca</a>

		<nav class="menu" id="menu">
			<a href="#" id="about-btn">About</a>
			<a href="#" id="projects-btn">Projects</a>
			<a href="#" id="contact-btn">Contact</a>
		</nav>

		<p class="clock" id="clock"></p>

		<script>
			const cursor = document.getElementById('custom-cursor');
			document.addEventListener('mousemove', function (e) {
				cursor.style.left = e.clientX + 'px';
				cursor.style.top = e.clientY + 'px';
			});

			function updateClock() {
				const now = new Date();
				const h = String(now.getHours()).padStart(2, '0');
				const m = String(now.getMinutes()).padStart(2, '0');
				const s = String(now.getSeconds()).padStart(2, '0');
				document.getElementById('clock').textContent = `${h}:${m}:${s}`;
			}
			updateClock();
			setInterval(updateClock, 1000);

			document.getElementById('name').addEventListener('click', function (e) {
				e.preventDefault();
				this.style.display = 'none';
				document.getElementById('menu').classList.add('visible');
				document.getElementById('quad-tl').classList.add('visible');
				document.getElementById('quad-tr').classList.add('visible');
				document.getElementById('quad-bl').classList.add('visible');
				document.getElementById('quad-br').classList.add('visible');
			});

			document.getElementById('back-btn').addEventListener('click', function () {
				document.getElementById('about-panel').classList.remove('visible');
				document.getElementById('back-btn').classList.remove('visible');
				document.getElementById('menu').classList.add('visible');
			});

			document.getElementById('about-btn').addEventListener('click', function (e) {
				e.preventDefault();
				document.getElementById('menu').classList.remove('visible');
				document.getElementById('about-panel').classList.add('visible');
				document.getElementById('back-btn').classList.add('visible');
			});

			document.getElementById('contact-form').addEventListener('submit', async function (e) {
				e.preventDefault();
				const form = e.target;
				const res = await fetch(form.action, {
					method: 'POST',
					body: new FormData(form),
					headers: { 'Accept': 'application/json' }
				});
				if (res.ok) {
					form.reset();
					document.getElementById('form-success').style.display = 'block';
				}
			});

			document.getElementById('contact-btn').addEventListener('click', function (e) {
				e.preventDefault();
				document.getElementById('menu').classList.remove('visible');
				document.getElementById('contact-panel').classList.add('visible');
				document.getElementById('back-btn-contact').classList.add('visible');
			});

			document.getElementById('back-btn-contact').addEventListener('click', function () {
				document.getElementById('contact-panel').classList.remove('visible');
				document.getElementById('back-btn-contact').classList.remove('visible');
				document.getElementById('menu').classList.add('visible');
			});

			// Projects list
			document.getElementById('projects-btn').addEventListener('click', function (e) {
				e.preventDefault();
				document.getElementById('menu').classList.remove('visible');
				document.getElementById('projects-list').classList.add('visible');
				document.getElementById('back-btn-projects').classList.add('visible');
			});

			document.getElementById('back-btn-projects').addEventListener('click', function () {
				document.getElementById('projects-list').classList.remove('visible');
				document.getElementById('back-btn-projects').classList.remove('visible');
				document.getElementById('menu').classList.add('visible');
			});

			// Trespass grid
			document.getElementById('trespass-btn').addEventListener('click', function (e) {
				e.preventDefault();
				document.getElementById('projects-list').classList.remove('visible');
				document.getElementById('back-btn-projects').classList.remove('visible');
				document.getElementById('trespass-grid').classList.add('visible');
				document.getElementById('back-btn-grid').classList.add('visible');
			});

			document.getElementById('back-btn-grid').addEventListener('click', function () {
				document.getElementById('trespass-grid').classList.remove('visible');
				document.getElementById('back-btn-grid').classList.remove('visible');
				document.getElementById('projects-list').classList.add('visible');
				document.getElementById('back-btn-projects').classList.add('visible');
			});

			// Project descriptions
			const trespassDesc = 'A grieving woman living in a decaying apartment building becomes obsessed with her neighbor. As she secretly watches the life unfolding through the cracks in the wall, her longing for connection spirals into a dangerous fixation with horrifying consequences.\n\nShort Film — Coming Soon, 2026';
			const projects = {
				'STILL01.jpg': { title: 'Trespass', desc: trespassDesc },
				'STILL02.jpg': { title: 'Trespass', desc: trespassDesc },
				'STILL03.jpg': { title: 'Trespass', desc: trespassDesc },
				'STILL04.jpg': { title: 'Trespass', desc: trespassDesc },
				'STILL05.jpg': { title: 'Trespass', desc: trespassDesc },
				'STILL06.jpg': { title: 'Trespass', desc: trespassDesc },
				'STILL07.jpg': { title: 'Trespass', desc: trespassDesc },
			};

			const detail = document.getElementById('project-detail');
			const detailImg = document.getElementById('detail-img');
			const detailTitle = document.getElementById('detail-title');
			const detailDesc = document.getElementById('detail-desc');

			document.querySelectorAll('.photo').forEach(function (img) {
				img.addEventListener('click', function () {
					const filename = this.src.split('/').pop();
					const info = projects[filename] || { title: '', desc: '' };
					detailImg.src = this.src;
					detailTitle.textContent = info.title;
					detailDesc.textContent = info.desc;
					document.getElementById('trespass-grid').classList.remove('visible');
					document.getElementById('back-btn-grid').classList.remove('visible');
					detail.classList.add('open');
				});
			});

			document.getElementById('back-btn-detail').addEventListener('click', function () {
				detail.classList.remove('open');
				document.getElementById('trespass-grid').classList.add('visible');
				document.getElementById('back-btn-grid').classList.add('visible');
			});
		</script>
	</body>
</html>

<style>
	@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600;700&display=swap');

	*, *::before, *::after {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	html, body {
		width: 100%;
		height: 100%;
		background: #000;
		overflow: hidden;
		cursor: none;
	}

	#custom-cursor {
		position: fixed;
		width: 12px;
		height: 12px;
		background: #fff;
		pointer-events: none;
		z-index: 9999;
		transform: translate(-50%, -50%);
		mix-blend-mode: difference;
	}

	/* ── Back buttons ── */
	.back-btn, .back-btn-contact, .back-btn-projects {
		position: fixed;
		font-family: 'Montserrat', sans-serif;
		font-size: 1.2rem;
		font-weight: 700;
		color: #fff;
		background: none;
		border: none;
		-webkit-text-stroke: 0.5px #fff;
		cursor: pointer;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.4s ease;
		z-index: 25;
		line-height: 1;
	}
	.back-btn          { top: calc(25% - 5.39vw - 1.8rem); left: calc(25% - 5.39vw); }
	.back-btn-contact  { top: calc(50% - 5.25vw - 1.8rem); left: calc(50% - 5.25vw); }
	.back-btn-projects { top: 1.5rem; left: 1.5rem; }
	.back-btn-grid     { top: 1.5rem; left: 1.5rem; color: #fff; -webkit-text-stroke: 0.5px #fff; }

	.back-btn.visible,
	.back-btn-contact.visible,
	.back-btn-projects.visible,
	.back-btn-grid.visible { opacity: 1; pointer-events: auto; }

	.back-btn:hover,
	.back-btn-contact:hover,
	.back-btn-projects:hover,
	.back-btn-grid:hover { opacity: 0.5; }

	/* ── About panel ── */
	.about-panel {
		position: fixed;
		top: 25%; left: 25%;
		width: 10.78vw; height: 10.78vw;
		transform: translate(-50%, -50%);
		background: #fff;
		z-index: 20;
		display: flex;
		flex-direction: column;
		justify-content: flex-start;
		padding: 0.7rem;
		gap: 0.4rem;
		overflow-y: auto;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.4s ease;
	}
	.about-panel.visible { opacity: 1; pointer-events: auto; }

	.about-panel h2 {
		font-family: 'Montserrat', sans-serif;
		font-size: 1.8rem; font-weight: 700;
		letter-spacing: 0.1em; text-transform: uppercase; color: #000;
	}
	.about-panel p {
		font-family: 'Montserrat', sans-serif;
		font-size: 0.72rem; font-weight: 300;
		letter-spacing: 0.03em;
		color: rgba(0,0,0,0.7);
		line-height: 1.7;
	}

	/* ── Contact panel ── */
	.contact-panel {
		position: fixed;
		top: 50%; left: 50%;
		width: 10.5vw; height: 10.5vw;
		transform: translate(-50%, -50%);
		background: #fff;
		z-index: 20;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding: 0.85rem;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.4s ease;
	}
	.contact-panel.visible { opacity: 1; pointer-events: auto; }

	.contact-panel h2 {
		font-family: 'Montserrat', sans-serif;
		font-size: 1.8rem; font-weight: 700;
		letter-spacing: 0.1em; text-transform: uppercase; color: #000;
	}
	.contact-panel form {
		display: flex; flex-direction: column;
		gap: 0.5rem; flex: 1; margin-top: 0.8rem;
	}
	.contact-panel input, .contact-panel textarea {
		background: none; border: none;
		border-bottom: 1px solid rgba(0,0,0,0.3);
		color: #000;
		font-family: 'Montserrat', sans-serif;
		font-size: 0.6rem; font-weight: 300;
		letter-spacing: 0.1em; padding: 0.3rem 0;
		outline: none; width: 100%;
	}
	.contact-panel textarea { flex: 1; resize: none; }
	.contact-panel input::placeholder,
	.contact-panel textarea::placeholder {
		color: rgba(0,0,0,0.4); text-transform: uppercase;
	}
	.contact-panel button {
		font-family: 'Montserrat', sans-serif;
		font-size: 0.6rem; font-weight: 700;
		letter-spacing: 0.2em; text-transform: uppercase;
		color: #000; background: none;
		border: 1px solid rgba(0,0,0,0.4);
		padding: 0.4rem; cursor: pointer;
		transition: background 0.2s, color 0.2s;
	}
	.contact-panel button:hover { background: #000; color: #fff; }
	.form-success {
		display: none;
		font-family: 'Montserrat', sans-serif;
		font-size: 0.6rem; font-weight: 300;
		letter-spacing: 0.1em; color: #000; text-transform: uppercase;
	}

	/* ── Projects list ── */
	.projects-list {
		position: fixed;
		inset: 0;
		background: #000;
		display: none;
		flex-direction: column;
		justify-content: center;
		padding: 6vw;
		z-index: 15;
	}
	.projects-list.visible { display: flex; }

	.project-title {
		font-family: 'Montserrat', sans-serif;
		text-decoration: none;
		display: flex;
		flex-direction: column;
		justify-content: flex-start;
		gap: 0.6rem;
		background: #fff;
		width: 11.9vw;
		height: 11.9vw;
		padding: 0.7rem;
		overflow-y: auto;
	}
	.project-title:hover { opacity: 0.6; }

	.project-name {
		font-size: 1.8rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: #000;
	}

	.project-subtitle {
		font-family: 'Montserrat', sans-serif;
		font-weight: 600;
		font-size: 0.72rem;
		color: rgba(0,0,0,0.6);
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.project-desc {
		font-size: 0.85rem;
		font-weight: 300;
		letter-spacing: 0.03em;
		color: rgba(0,0,0,0.7);
		line-height: 1.7;
		text-transform: none;
	}

	/* ── Credits bar ── */
	.credits-bar {
		grid-column: 1 / -1;
		overflow: hidden;
		white-space: nowrap;
		height: 2rem;
		line-height: 2rem;
		border-bottom: 1px solid rgba(255,255,255,0.15);
		margin-bottom: 0.5rem;
	}

	.credits-track {
		display: inline-block;
		animation: scroll-credits 300s linear infinite;
		font-family: 'Montserrat', sans-serif;
		font-size: 0.85rem;
		font-weight: 400;
		letter-spacing: 0.12em;
		color: #fff;
		text-transform: uppercase;
		line-height: 2rem;
	}

	@keyframes scroll-credits {
		0%   { transform: translateX(0); }
		100% { transform: translateX(-50%); }
	}

	/* ── Trespass grid ── */
	.trespass-grid {
		position: fixed;
		inset: 0;
		background: #000;
		display: none;
		grid-template-columns: repeat(4, 1fr);
		gap: 0.5vw;
		padding: 1.5rem 4vw 4vw 4vw;
		align-content: start;
		overflow-y: auto;
		z-index: 15;
	}
	.trespass-grid.visible { display: grid; }

	.photo {
		width: 100%;
		aspect-ratio: 1600 / 864;
		object-fit: cover;
		cursor: pointer;
		transition: opacity 0.2s ease;
	}
	.photo:hover { opacity: 0.8; }

	.placeholder {
		background: #222;
	}

	/* ── Project detail ── */
	.project-detail {
		position: fixed;
		inset: 0;
		background: #000;
		display: none;
		align-items: center;
		justify-content: center;
		gap: 4vw;
		padding: 4vw;
		z-index: 50;
	}
	.project-detail.open { display: flex; }

	.back-btn-detail {
		position: fixed;
		top: 1.5rem; left: 1.5rem;
		font-family: 'Montserrat', sans-serif;
		font-size: 1.2rem; font-weight: 700;
		color: #fff; background: none; border: none;
		-webkit-text-stroke: 0.5px #fff;
		cursor: pointer; z-index: 55;
	}
	.back-btn-detail:hover { opacity: 0.5; }

	.detail-image-wrap {
		flex: 1;
		display: flex;
		align-items: center;
		justify-content: flex-end;
	}
	.detail-img {
		max-height: 80vh;
		max-width: 50vw;
		object-fit: contain;
	}

	.detail-info {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		max-width: 30vw;
	}
	.detail-info h2 {
		font-family: 'Montserrat', sans-serif;
		font-size: 1.8rem; font-weight: 700;
		letter-spacing: 0.1em; text-transform: uppercase; color: #fff;
	}
	.detail-info p {
		font-family: 'Montserrat', sans-serif;
		font-size: 0.75rem; font-weight: 300;
		letter-spacing: 0.05em; color: rgba(255,255,255,0.6);
		line-height: 1.8;
	}

	/* ── Quad overlays ── */
	.quad {
		position: fixed;
		background: #000;
		z-index: 1;
		opacity: 0;
		transition: opacity 0.4s ease;
		pointer-events: none;
	}
	.quad.visible { opacity: 1; pointer-events: auto; }
	.quad-tl { top: 0; left: 0; width: 50%; height: 50%; }
	.quad-tr { top: 0; left: 50%; width: 50%; height: 50%; }
	.quad-bl { top: 50%; left: 0; width: 50%; height: 50%; }
	.quad-br { top: 50%; left: 50%; width: 50%; height: 50%; }

	/* ── Name ── */
	.name {
		position: fixed;
		top: 50%; left: 50%;
		transform: translate(-50%, -50%);
		font-family: 'Montserrat', sans-serif;
		font-size: 1.235rem; font-weight: 700;
		letter-spacing: 0.3em; text-transform: uppercase;
		color: #fff; text-decoration: none;
		white-space: nowrap; z-index: 5; cursor: pointer;
	}
	.name:hover { opacity: 0.6; }

	/* ── Menu ── */
	.menu {
