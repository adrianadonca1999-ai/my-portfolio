		<p class="clock" id="clock"></p>

		<script>
			const cursor = document.getElementById('custom-cursor');
			document.addEventListener('mousemove', function(e) {
				cursor.style.left = e.clientX + 'px';
				cursor.style.top = e.clientY + 'px';
			});

			function updateClock() {
				const now = new Date();
				const h = String(now.getHours()).padStart(2, '0');
				const m = String(now.getMinutes()).padStart(2, '0');
				const s = String(now.getSeconds()).padStart(2, '0');
				document.getElementById('clock').textContent = `${h}:${m}:${s}`;
			}
			updateClock();
			setInterval(updateClock, 1000);

			// Views (project grids + about/contact panels) with real browser-history support,
			// so the browser/mouse back button closes the view instead of leaving the site.
			const viewIds = {
				trespass: ['trespass-grid', 'back-btn-grid'],
				dance: ['dance-grid', 'back-btn-dance'],
				served: ['served-grid', 'back-btn-served'],
				macbeth: ['macbeth-grid', 'back-btn-macbeth'],
				house: ['house-grid', 'back-btn-house'],
				interior: ['interior-grid', 'back-btn-interior'],
				spermania: ['spermania-grid', 'back-btn-spermania'],
				about: ['about-panel', 'back-btn'],
				contact: ['contact-panel', 'back-btn-contact'],
			};

			function hideAllViews() {
				Object.values(viewIds).forEach(function(ids) {
					document.getElementById(ids[0]).classList.remove('visible');
					document.getElementById(ids[1]).classList.remove('visible');
				});
			}

			function showView(name, push) {
				hideAllViews();
				const ids = viewIds[name];
				if (!ids) return;
				document.getElementById(ids[0]).classList.add('visible');
				document.getElementById(ids[1]).classList.add('visible');
				if (push) history.pushState({ view: name }, '', '#' + name);
			}

			window.addEventListener('popstate', function(e) {
				const view = e.state && e.state.view;
				if (view) {
					showView(view, false);
				} else {
					hideAllViews();
				}
			});

			if (!history.state) {
				history.replaceState({ view: null }, '', location.pathname + location.search);
			}

			// About
			document.getElementById('about-btn').addEventListener('click', function(e) {
				e.preventDefault();
				showView('about', true);
			});
			document.getElementById('back-btn').addEventListener('click', function() { history.back(); });
			document.getElementById('about-btn-inner').addEventListener('click', function(e) { e.preventDefault(); });
			document.getElementById('contact-btn-inner').addEventListener('click', function(e) {
				e.preventDefault();
				showView('contact', true);
			});

			// Contact
			document.getElementById('contact-btn').addEventListener('click', function(e) {
				e.preventDefault();
				showView('contact', true);
			});
			document.getElementById('back-btn-contact').addEventListener('click', function() { history.back(); });
			document.getElementById('contact-about-btn').addEventListener('click', function(e) {
				e.preventDefault();
				showView('about', true);
			});
			document.getElementById('contact-contact-btn').addEventListener('click', function(e) { e.preventDefault(); });

			// Contact form
			document.getElementById('contact-form').addEventListener('submit', async function(e) {
				e.preventDefault();
				const form = e.target;
				const res = await fetch(form.action, {
					method: 'POST',
					body: new FormData(form),
					headers: { 'Accept': 'application/json' }
				});
				if (res.ok) {
					form.reset();
					document.getElementById('form-success').style.display = 'block';
				}
			});

			// Project grids back → homepage (via browser history)
			document.getElementById('back-btn-grid').addEventListener('click', function() { history.back(); });
			document.getElementById('back-btn-dance').addEventListener('click', function() { history.back(); });
			document.getElementById('back-btn-served').addEventListener('click', function() { history.back(); });
			document.getElementById('back-btn-macbeth').addEventListener('click', function() { history.back(); });
			document.getElementById('back-btn-house').addEventListener('click', function() { history.back(); });
			document.getElementById('back-btn-interior').addEventListener('click', function() { history.back(); });
			document.getElementById('back-btn-spermania').addEventListener('click', function() { history.back(); });

			// Homepage cards (direct to project grids)
			document.getElementById('hp-trespass').addEventListener('click', function() { showView('trespass', true); });
			document.getElementById('hp-dance').addEventListener('click', function() { showView('dance', true); });
			document.getElementById('hp-served').addEventListener('click', function() { showView('served', true); });
			document.getElementById('hp-macbeth').addEventListener('click', function() { showView('macbeth', true); });
			document.getElementById('hp-house').addEventListener('click', function() { showView('house', true); });
			document.getElementById('hp-interior').addEventListener('click', function() { showView('interior', true); });
			document.getElementById('hp-spermania').addEventListener('click', function() { showView('spermania', true); });

			// Lightbox
			const lightbox = document.getElementById('lightbox');
			const lightboxImg = document.getElementById('lightbox-img');
			const lightboxCredits = document.getElementById('lightbox-credits-text');
			const lightboxNext = document.getElementById('lightbox-next');
			lightboxNext.style.display = 'none';

			lightbox.addEventListener('click', function() {
				lightbox.classList.remove('open');
				lightboxImg.src = '';
			});

			// Grid gallery (all images shown at once, opens lightbox on click)
			function initGrid(gridId) {
				const grid = document.getElementById(gridId);
				if (!grid) return;
				grid.querySelectorAll('img').forEach(function(img) {
					img.addEventListener('click', function() {
						lightboxImg.src = img.src;
						lightboxCredits.textContent = img.dataset.credits || '';
						lightbox.classList.add('open');
					});
				});
			}

			initGrid('stills-grid');
			initGrid('setphoto-grid');
			initGrid('process-grid');
			initGrid('dance-final-grid');
			initGrid('dance-process-grid');
			initGrid('dance-ue-grid');
			initGrid('served-final-grid');
			initGrid('served-process-grid');
			initGrid('macbeth-stills-grid');
			initGrid('macbeth-process-grid');
			initGrid('house-stills-grid');
			initGrid('house-process-grid');
			initGrid('interior-drafting-grid');
			initGrid('interior-3d-grid');
			initGrid('interior-renderings-grid');
			initGrid('spermania-stills-grid');
			initGrid('spermania-concept-grid');
			initGrid('spermania-references-grid');

			// Homepage carousel
			(function() {
				var hpImgs = document.querySelectorAll('.hp-carousel-img');
				var hpDots = document.querySelectorAll('.hp-dot');
				var hpCur = 0;
				var hpTimer;

				function hpGoTo(idx) {
					hpImgs[hpCur].classList.remove('active');
					hpDots[hpCur].classList.remove('active');
					hpCur = (idx + hpImgs.length) % hpImgs.length;
					hpImgs[hpCur].classList.add('active');
					hpDots[hpCur].classList.add('active');
				}

				function hpResetTimer() {
					clearInterval(hpTimer);
					hpTimer = setInterval(function() { hpGoTo(hpCur + 1); }, 4500);
				}

				document.getElementById('hp-prev').addEventListener('click', function(e) {
					e.stopPropagation(); hpGoTo(hpCur - 1); hpResetTimer();
				});
				document.getElementById('hp-next').addEventListener('click', function(e) {
					e.stopPropagation(); hpGoTo(hpCur + 1); hpResetTimer();
				});
				hpDots.forEach(function(dot) {
					dot.addEventListener('click', function(e) {
						e.stopPropagation(); hpGoTo(Number(dot.dataset.idx)); hpResetTimer();
					});
				});

				hpTimer = setInterval(function() { hpGoTo(hpCur + 1); }, 4500);
			})();
		</script>
	</body>
