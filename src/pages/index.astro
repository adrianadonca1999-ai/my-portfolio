	/* ── Project grid ── */
	.project-grid {
		max-width: 1200px;
		margin: 3rem auto;
		padding: 0 6vw;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.5rem;
	}

	.project-card {
		cursor: pointer;
	}

	.project-thumb {
		width: 100%;
		aspect-ratio: 16 / 9;
		background: #1a1a1a;
		position: relative;
		overflow: hidden;
		display: flex;
		align-items: flex-end;
		transition: opacity 0.25s ease;
	}
	.project-card:hover .project-thumb { opacity: 0.75; }

	.project-thumb img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.project-thumb-label {
		font-family: 'Montserrat', sans-serif;
		font-size: 1rem;
		font-weight: 700;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: #fff;
		padding: 0.75rem 1rem;
		position: relative;
		z-index: 1;
	}

	/* ── Clock ── */
	.clock {
		position: fixed;
		bottom: 1.5rem;
		right: 1.5rem;
		font-family: 'Montserrat', sans-serif;
		font-size: 0.8rem;
		font-weight: 300;
		letter-spacing: 0.15em;
		color: rgba(0, 0, 0, 0.35);
		z-index: 10;
	}

	/* ── About panel ── */
	.about-panel {
		position: fixed;
		inset: 0;
		background: #fff;
		z-index: 20;
		display: none;
		flex-direction: column;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.4s ease;
		overflow-y: auto;
		scrollbar-width: none;
	}
	.about-panel::-webkit-scrollbar { display: none; }
	.about-panel.visible { display: flex; opacity: 1; pointer-events: auto; }

	.about-panel .site-header { padding-top: 3rem; }
	.about-panel .site-name { color: #000; }
	.about-panel .site-divider { border-top-color: rgba(0,0,0,0.3); }
	.about-panel .site-nav { border-bottom-color: rgba(0,0,0,0.3); }
	.about-panel .site-nav a { color: rgba(0,0,0,0.6); }
	.about-panel .site-nav a:hover { color: #000; }

	#back-btn { color: #000; -webkit-text-stroke: 0.5px #000; }

	.about-content {
		max-width: 960px;
		margin: 2.5rem auto 6rem;
		padding: 0 6vw;
	}

	.about-top-rule {
		border: none;
		border-top: 1px solid #000;
