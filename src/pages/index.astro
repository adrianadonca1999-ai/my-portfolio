	.about-section { margin-bottom: 0; }

	.about-section-title {
		font-family: 'Montserrat', sans-serif;
		font-size: 1.05rem;
		font-weight: 400;
		letter-spacing: 0.02em;
		color: #000;
		margin-bottom: 1.2rem;
