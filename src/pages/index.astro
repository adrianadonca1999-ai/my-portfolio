	}

	.hp-proj-title-wrap {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		flex: 1;
	}

	.hp-proj-title {
		font-family: 'Montserrat', sans-serif;
		font-size: 0.78rem;
		font-weight: 400;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: #000;
	}

	.hp-proj-sub {
		font-family: 'Montserrat', sans-serif;
		font-size: 0.58rem;
		font-weight: 300;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: rgba(0, 0, 0, 0.4);
	}

	.hp-proj-inactive {
		display: flex;
		align-items: baseline;
		gap: 1rem;
		padding: 0.6rem 0;
		cursor: default;
		pointer-events: none;
	}

