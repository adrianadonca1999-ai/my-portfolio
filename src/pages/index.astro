			const cursor = document.getElementById('custom-cursor');
			document.addEventListener('mousemove', function(e) {
				cursor.style.left = e.clientX + 'px';
				cursor.style.top = e.clientY + 'px';
			});

			function updateClock() {
				const now = new Date();
				const h = String(now.getHours()).padStart(2, '0');
				const m = String(now.getMinutes()).padStart(2, '0');
				const s = String(now.getSeconds()).padStart(2, '0');
				document.getElementById('clock').textContent = `${h}:${m}:${s}`;
			}
			updateClock();
			setInterval(updateClock, 1000);

			// About
			function closeAbout() {
				document.getElementById('about-panel').classList.remove('visible');
				document.getElementById('back-btn').classList.remove('visible');
			}
			document.getElementById('about-btn').addEventListener('click', function(e) {
				e.preventDefault();
				document.getElementById('about-panel').classList.add('visible');
				document.getElementById('back-btn').classList.add('visible');
			});
			document.getElementById('back-btn').addEventListener('click', closeAbout);
			document.getElementById('about-btn-inner').addEventListener('click', function(e) { e.preventDefault(); });
			document.getElementById('contact-btn-inner').addEventListener('click', function(e) {
				e.preventDefault();
				closeAbout();
				document.getElementById('contact-panel').classList.add('visible');
				document.getElementById('back-btn-contact').classList.add('visible');
			});


			// Contact
			function closeContact() {
				document.getElementById('contact-panel').classList.remove('visible');
				document.getElementById('back-btn-contact').classList.remove('visible');
			}
			document.getElementById('contact-btn').addEventListener('click', function(e) {
				e.preventDefault();
				document.getElementById('contact-panel').classList.add('visible');
				document.getElementById('back-btn-contact').classList.add('visible');
			});
			document.getElementById('back-btn-contact').addEventListener('click', closeContact);
			document.getElementById('contact-about-btn').addEventListener('click', function(e) {
				e.preventDefault();
				closeContact();
				document.getElementById('about-panel').classList.add('visible');
				document.getElementById('back-btn').classList.add('visible');
			});
			document.getElementById('contact-contact-btn').addEventListener('click', function(e) { e.preventDefault(); });

			// Contact form
			document.getElementById('contact-form').addEventListener('submit', async function(e) {
				e.preventDefault();
				const form = e.target;
				const res = await fetch(form.action, {
					method: 'POST',
					body: new FormData(form),
					headers: { 'Accept': 'application/json' }
				});
				if (res.ok) {
					form.reset();
					document.getElementById('form-success').style.display = 'block';
				}
			});

			// Trespass back → homepage
			document.getElementById('back-btn-grid').addEventListener('click', function() {
				document.getElementById('trespass-grid').classList.remove('visible');
				document.getElementById('back-btn-grid').classList.remove('visible');
			});

			// Dance back → homepage
			document.getElementById('back-btn-dance').addEventListener('click', function() {
				document.getElementById('dance-grid').classList.remove('visible');
				document.getElementById('back-btn-dance').classList.remove('visible');
			});

			// Homepage cards (direct to project grids)
			document.getElementById('hp-trespass').addEventListener('click', function() {
				document.getElementById('trespass-grid').classList.add('visible');
				document.getElementById('back-btn-grid').classList.add('visible');
			});
			document.getElementById('hp-dance').addEventListener('click', function() {
				document.getElementById('dance-grid').classList.add('visible');
				document.getElementById('back-btn-dance').classList.add('visible');
			});

			// Lightbox
			const lightbox = document.getElementById('lightbox');
			const lightboxImg = document.getElementById('lightbox-img');
			const lightboxCredits = document.getElementById('lightbox-credits-text');
			const lightboxNext = document.getElementById('lightbox-next');
			lightboxNext.style.display = 'none';

			lightbox.addEventListener('click', function() {
				lightbox.classList.remove('open');
				lightboxImg.src = '';
			});

			// Carousel system
			function initCarousel(trackId, counterId) {
				const track = document.getElementById(trackId);
				if (!track) return;
				const counter = document.getElementById(counterId);
				const items = Array.from(track.querySelectorAll('img'));
				let current = 0;
				const total = items.length;
				const wrap = track.closest('.carousel-wrap');

				function update() {
					track.style.transform = `translateX(-${current * 100}%)`;
					if (counter) counter.textContent = `${current + 1} / ${total}`;
				}

				wrap.querySelector('.car-prev').addEventListener('click', function(e) {
					e.stopPropagation();
					current = (current - 1 + total) % total;
					update();
				});
				wrap.querySelector('.car-next').addEventListener('click', function(e) {
					e.stopPropagation();
					current = (current + 1) % total;
					update();
				});

				items.forEach(function(img) {
					img.addEventListener('click', function() {
						lightboxImg.src = img.src;
						lightboxCredits.textContent = img.dataset.credits || '';
						lightbox.classList.add('open');
					});
				});
			}

			initCarousel('stills-track', 'stills-counter');
			initCarousel('setphoto-track', 'setphoto-counter');
			initCarousel('process-track', 'process-counter');
			initCarousel('dance-process-track', 'dance-process-counter');
			initCarousel('dance-ue-track', 'dance-ue-counter');

			// Homepage carousel
			(function() {
				var hpImgs = document.querySelectorAll('.hp-carousel-img');
				var hpDots = document.querySelectorAll('.hp-dot');
				var hpCur = 0;
				var hpTimer;

				function hpGoTo(idx) {
					hpImgs[hpCur].classList.remove('active');
					hpDots[hpCur].classList.remove('active');
					hpCur = (idx + hpImgs.length) % hpImgs.length;
					hpImgs[hpCur].classList.add('active');
					hpDots[hpCur].classList.add('active');
				}

				function hpResetTimer() {
					clearInterval(hpTimer);
					hpTimer = setInterval(function() { hpGoTo(hpCur + 1); }, 4500);
				}

				document.getElementById('hp-prev').addEventListener('click', function(e) {
					e.stopPropagation(); hpGoTo(hpCur - 1); hpResetTimer();
				});
				document.getElementById('hp-next').addEventListener('click', function(e) {
					e.stopPropagation(); hpGoTo(hpCur + 1); hpResetTimer();
				});
				hpDots.forEach(function(dot) {
					dot.addEventListener('click', function(e) {
						e.stopPropagation(); hpGoTo(Number(dot.dataset.idx)); hpResetTimer();
					});
				});

				hpTimer = setInterval(function() { hpGoTo(hpCur + 1); }, 4500);
			})();
		</script>
	</body>
